---
layout: layouts/base.njk
title: Yincan Huang
---

<section class="intro">
  <p>Ideas, essays, and projects.</p>
</section>

<p class="section-title"><a href="{{ collections.posts[0].url | url }}" class="plain">Latest</a></p>

<article class="latest-post">
  <h3><a href="{{ collections.posts[0].url | url }}">{{ collections.posts[0].data.title }}</a></h3>
  <div class="post-meta">
    <time>{{ collections.posts[0].date | readableDate }}</time>
    <span> · </span>
    <span>{{ collections.posts[0].templateContent | readingTime }}</span>
  </div>
  {% if collections.posts[0].data.description %}
  <p class="post-excerpt">{{ collections.posts[0].data.description }}</p>
  {% endif %}
</article>

<hr class="section-divider">

<p class="section-title"><a href="{{ '/topics/' | url }}" class="plain">Topics</a></p>

<div class="tag-cloud">
  {% for tag in collections.tagList %}
  <a href="{{ ('/topics/' + (tag | slugify) + '/') | url }}" class="tag-link">{{ tag }}</a>{% if not loop.last %}<span class="tag-comma">, </span>{% endif %}
  {% endfor %}
</div>

<hr class="section-divider">

<p class="section-title"><a href="{{ '/writing/' | url }}" class="plain">Archive</a></p>

<ul class="post-list">
  {% for post in collections.posts %}
  <li class="post-item">
    <time class="post-date">{{ post.date | yearMonth }}</time>
    <a href="{{ post.url | url }}" class="post-title">{{ post.data.title }}</a>
  </li>
  {% endfor %}
</ul>

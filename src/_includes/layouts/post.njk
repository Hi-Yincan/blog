---
layout: layouts/base.njk
---

<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <div class="post-meta">
      <time datetime="{{ date }}">{{ date | readableDate }}</time>
      {% if tags %}
        <span> · </span>
        {% for tag in tags %}
          <a href="/topics/{{ tag | slugify }}/">#{{ tag }}</a>{% if not loop.last %}, {% endif %}
        {% endfor %}
      {% endif %}
      <span> · </span>
      <span>{{ content | readingTime }} read</span>
    </div>
  </header>

  <div class="post-content">
    {{ content | safe }}
  </div>
</article>

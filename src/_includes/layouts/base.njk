<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or 'Personal blog with minimalist design and Flexoki color scheme' }}">
  <meta name="author" content="Yincan Huang">
  {% if unlisted %}<meta name="robots" content="noindex">{% endif %}

  <!-- Open Graph / Social -->
  <meta property="og:site_name" content="Yincan Huang">
  <meta property="og:url" content="{{ page.url }}">
  <meta property="og:title" content="{{ title or 'Yincan Huang' }}">
  <meta property="og:description" content="{{ description or 'Yincan&#39;s blog' }}">
  <meta property="og:type" content="article">

  <title>{{ title or 'Yincan Huang' }}</title>

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="{{ '/assets/images/favicon.png' | url }}">

  <!-- Styles -->
  <link rel="stylesheet" href="{{ '/styles/flexoki.css' | url }}">
  <link rel="stylesheet" href="{{ '/styles/main.css' | url }}">

  <!-- Theme detection script (inline to prevent FOUC) -->
  <script>
    (function() {
      const theme = localStorage.getItem('theme') ||
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      if (theme === 'dark') {
        document.documentElement.classList.add('theme-dark');
      }
    })();
  </script>

  <!-- Analytics -->
  <script defer src="https://umami.nvc.ac/script.js" data-website-id="9c00b488-0f87-4a01-a412-2a31db230ddb"></script>
</head>
<body>
  <div class="container">
    {% include "partials/header.njk" %}

    <main>
      {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}
  </div>

  <script src="{{ '/js/theme.js' | url }}"></script>
</body>
</html>
